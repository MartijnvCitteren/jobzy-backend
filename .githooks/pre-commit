#!/usr/bin/env bash
# Git pre-commit hook: scans the staged changes for secrets with gitleaks.
# One-time setup per clone: ln -s ../../.githooks/pre-commit .git/hooks/pre-commit
# (a symlink rather than core.hooksPath, so local untracked hooks in .git/hooks keep working).
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Commit blocked." >&2
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner --verbose
